# --- PostgreSQL (used by docker-compose.yml and Prisma) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
POSTGRES_PORT=5432

# Must stay in sync with the POSTGRES_* values above
DATABASE_URL="postgresql://jarvis:jarvis@localhost:5432/jarvis?schema=public"

# --- apps/api ---
PORT=4000
NODE_ENV=development

# --- apps/api: chat via OpenRouter ---
# Required. Get a key at https://openrouter.ai/keys — keep this out of version control.
OPENROUTER_API_KEY=
# Optional overrides (defaults shown):
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=
